<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ── Base App Theme ────────────────────────────────────── -->
    <style name="Theme.SmartAttend" parent="Theme.MaterialComponents.DayNight.NoActionBar">

        <!-- Primary brand color -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary color -->
        <item name="colorSecondary">@color/violet_600</item>
        <item name="colorSecondaryVariant">@color/violet_700</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/slate_900</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/gray_600</item>

        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/gray_900</item>

        <!-- Error -->
        <item name="colorError">@color/red_600</item>
        <item name="colorOnError">@color/white</item>

        <!-- Elevation / shadow -->
        <item name="elevationOverlayEnabled">true</item>

        <!-- Status / Nav bars -->
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text appearance -->
        <item name="textAppearanceBody1">@style/TextAppearance.SmartAttend.Body1</item>
        <item name="textAppearanceBody2">@style/TextAppearance.SmartAttend.Body2</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.SmartAttend.Subtitle1</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.SmartAttend.Subtitle2</item>
        <item name="textAppearanceHeadline6">@style/TextAppearance.SmartAttend.Headline6</item>

        <!-- Material Button default shape -->
        <item name="materialButtonStyle">@style/Widget.SmartAttend.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.SmartAttend.Button.Outlined</item>

        <!-- Card default shape -->
        <item name="materialCardViewStyle">@style/Widget.SmartAttend.Card</item>

        <!-- Bottom navigation -->
        <item name="bottomNavigationStyle">@style/Widget.SmartAttend.BottomNavigation</item>

    </style>

    <!-- ── Splash Theme (fullscreen) ─────────────────────────── -->
    <style name="Theme.SmartAttend.Splash" parent="Theme.SmartAttend">
        <item name="android:statusBarColor">@color/slate_900</item>
        <item name="android:navigationBarColor">@color/slate_900</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <!-- ── App Bar Overlay ────────────────────────────────────── -->
    <style name="Theme.SmartAttend.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- ── Text Appearances ───────────────────────────────────── -->
    <style name="TextAppearance.SmartAttend.Headline6" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/gray_900</item>
        <item name="fontWeight">700</item>
    </style>

    <style name="TextAppearance.SmartAttend.Subtitle1" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/gray_800</item>
        <item name="fontWeight">600</item>
    </style>

    <style name="TextAppearance.SmartAttend.Subtitle2" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/gray_600</item>
    </style>

    <style name="TextAppearance.SmartAttend.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/gray_700</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextAppearance.SmartAttend.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/gray_500</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <!-- ── Button Styles ──────────────────────────────────────── -->
    <style name="Widget.SmartAttend.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="rippleColor">@color/blue_700</item>
    </style>

    <style name="Widget.SmartAttend.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="strokeColor">@color/brand_primary</item>
        <item name="android:textColor">@color/brand_primary</item>
    </style>

    <style name="Widget.SmartAttend.Button.Success" parent="Widget.SmartAttend.Button">
        <item name="backgroundTint">@color/emerald_600</item>
        <item name="rippleColor">@color/green_700</item>
    </style>

    <style name="Widget.SmartAttend.Button.Danger" parent="Widget.SmartAttend.Button">
        <item name="backgroundTint">@color/red_600</item>
        <item name="rippleColor">@color/red_600</item>
    </style>

    <!-- ── Card Style ─────────────────────────────────────────── -->
    <style name="Widget.SmartAttend.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="strokeColor">@color/divider</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPaddingLeft">16dp</item>
        <item name="contentPaddingTop">16dp</item>
        <item name="contentPaddingRight">16dp</item>
        <item name="contentPaddingBottom">16dp</item>
    </style>

    <!-- ── TextInput Style ────────────────────────────────────── -->
    <style name="Widget.SmartAttend.TextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/gray_300</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/brand_primary</item>
    </style>

    <!-- ── Bottom Navigation ──────────────────────────────────── -->
    <style name="Widget.SmartAttend.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/bottom_nav_color</item>
        <item name="itemTextColor">@color/bottom_nav_color</item>
        <item name="elevation">8dp</item>
    </style>

    <!-- ── Toolbar ────────────────────────────────────────────── -->
    <style name="Widget.SmartAttend.Toolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/brand_primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="titleTextAppearance">@style/TextAppearance.SmartAttend.Headline6</item>
    </style>

    <!-- ── Chip style ─────────────────────────────────────────── -->
    <style name="Widget.SmartAttend.Chip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipCornerRadius">20dp</item>
        <item name="chipMinHeight">32dp</item>
        <item name="android:textSize">12sp</item>
    </style>

</resources>
