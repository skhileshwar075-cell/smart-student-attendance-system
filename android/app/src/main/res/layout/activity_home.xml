<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center">

        <!-- ── HEADER ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="8dp">

            <androidx.cardview.widget.CardView
                android:layout_width="44dp"
                android:layout_height="44dp"
                app:cardCornerRadius="11dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#2563EB"
                android:layout_marginEnd="10dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_graduation_cap"
                    android:tint="@android:color/white"
                    android:padding="10dp"
                    android:scaleType="fitCenter" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SmartAttend"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@android:color/white" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure Attendance System"
            android:textSize="13sp"
            android:textColor="#64748B"
            android:letterSpacing="0.05"
            android:layout_marginBottom="36dp" />

        <!-- ── HERO BADGE ──────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <View
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_green_solid"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Face · GPS · QR Verified"
                    android:textSize="12sp"
                    android:textColor="#60A5FA" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── TAGLINE ──────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your role to continue"
            android:textSize="16sp"
            android:textColor="#94A3B8"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <!-- ── STUDENT CARD ─────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#064E3B"
            app:strokeColor="#065F46"
            app:strokeWidth="1dp"
            android:layout_marginBottom="14dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#065F46"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_student"
                        android:tint="#6EE7B7"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student Login"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#ECFDF5" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mark attendance &amp; view records"
                        android:textSize="12sp"
                        android:textColor="#6EE7B7"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#6EE7B7" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── TEACHER CARD ─────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardTeacher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#1E3A8A"
            app:strokeColor="#1D4ED8"
            app:strokeWidth="1dp"
            android:layout_marginBottom="14dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#1D4ED8"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_teacher"
                        android:tint="#BFDBFE"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Teacher Login"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#EFF6FF" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="  Most Used"
                            android:textSize="10sp"
                            android:textColor="#93C5FD"
                            android:background="@drawable/badge_blue"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage students &amp; sessions"
                        android:textSize="12sp"
                        android:textColor="#93C5FD"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#93C5FD" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── ADMIN CARD ───────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#2E1065"
            app:strokeColor="#5B21B6"
            app:strokeWidth="1dp"
            android:layout_marginBottom="32dp"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="20dp">

                <androidx.cardview.widget.CardView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#4C1D95"
                    android:layout_marginEnd="16dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_shield"
                        android:tint="#DDD6FE"
                        android:padding="12dp"
                        android:scaleType="fitCenter" />

                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Admin Login"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#F5F3FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="System management &amp; analytics"
                        android:textSize="12sp"
                        android:textColor="#C4B5FD"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_arrow_right"
                    android:tint="#C4B5FD" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ── DIVIDER ──────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#1E293B" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  or  " android:textColor="#334155" android:textSize="12sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#1E293B" />
        </LinearLayout>

        <!-- ── REGISTER BUTTON ─────────────────────────── -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegister"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Register as Student"
            android:textSize="14sp"
            android:textColor="#60A5FA"
            app:strokeColor="#1D4ED8"
            app:strokeWidth="1dp"
            app:cornerRadius="14dp"
            android:layout_marginBottom="12dp" />

        <!-- ── FORGOT PASSWORD ─────────────────────────── -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Forgot password?"
            android:textSize="13sp"
            android:textColor="#2563EB"
            android:padding="8dp"
            android:layout_marginBottom="28dp" />

        <!-- ── FEATURE PILLS ───────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Face ID"
                android:textSize="11sp"
                android:textColor="#60A5FA"
                android:background="@drawable/pill_blue"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geo-fence"
                android:textSize="11sp"
                android:textColor="#6EE7B7"
                android:background="@drawable/pill_green"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QR Session"
                android:textSize="11sp"
                android:textColor="#C4B5FD"
                android:background="@drawable/pill_violet"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp" />

        </LinearLayout>

        <!-- ── VERSION ─────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartAttend v2.0 · Kotlin + Firebase + ML Kit"
            android:textSize="10sp"
            android:textColor="#1E293B"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
