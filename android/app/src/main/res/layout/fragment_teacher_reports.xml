<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/surface">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance Reports"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_marginBottom="12dp" />

            <Spinner
                android:id="@+id/spinnerSubject"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input_rounded"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvRowCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/gray_500"
                    android:textSize="12sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadReport"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Load Report"
                    android:textSize="12sp"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportCsv"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Detailed"
                    android:textSize="11sp"
                    android:layout_marginEnd="4dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Summary"
                    android:textSize="11sp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@color/surface"
            android:layout_marginTop="1dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Download Shortlist"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/red_500"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etShortlistFrom"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="From (YYYY-MM-DD)"
                    android:textSize="11sp"
                    android:inputType="date"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="8dp"
                    android:layout_marginEnd="6dp" />

                <EditText
                    android:id="@+id/etShortlistTo"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:hint="To (YYYY-MM-DD)"
                    android:textSize="11sp"
                    android:inputType="date"
                    android:background="@drawable/bg_input_rounded"
                    android:paddingHorizontal="8dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tvThresholdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Below 75%"
                    android:textSize="12sp"
                    android:textColor="@color/red_500"
                    android:layout_marginEnd="8dp" />

                <SeekBar
                    android:id="@+id/seekThreshold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:max="99"
                    android:progress="74"
                    android:layout_marginEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDownloadShortlist"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Download"
                    android:textSize="11sp"
                    app:backgroundTint="@color/red_500" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/gray_100"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="Student" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/gray_600" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Present" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/gray_600" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Absent" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/gray_600" android:gravity="center" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="%" android:textStyle="bold" android:textSize="12sp" android:textColor="@color/gray_600" android:gravity="end" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a subject and tap Load Report"
            android:gravity="center"
            android:padding="40dp"
            android:textColor="@color/gray_400"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReport"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
