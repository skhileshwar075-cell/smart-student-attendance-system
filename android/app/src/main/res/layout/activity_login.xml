<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:paddingTop="56dp"
        android:paddingBottom="32dp">

        <!-- ── Logo + Branding ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="36dp">

            <androidx.cardview.widget.CardView
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="18dp"
                app:cardElevation="16dp"
                app:cardBackgroundColor="#2563EB"
                android:layout_marginBottom="16dp"
                android:layout_gravity="center">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/ic_graduation_cap"
                    android:tint="@android:color/white"
                    android:padding="16dp"
                    android:scaleType="fitCenter" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SmartAttend"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:layout_gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Smart Secure Attendance System"
                android:textSize="13sp"
                android:textColor="#64748B"
                android:layout_marginTop="4dp"
                android:layout_gravity="center" />

        </LinearLayout>

        <!-- ── Role indicator badge ────────────────────────────── -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardRoleBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#1E293B"
            android:layout_marginBottom="20dp"
            android:layout_gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp">

                <View
                    android:id="@+id/viewRoleDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/circle_blue_solid"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/tvRoleLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Signing in as Student"
                    android:textSize="12sp"
                    android:textColor="#93C5FD" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ── Login Card ──────────────────────────────────────── -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@android:color/white"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Form title -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome back"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enter your credentials to continue"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginBottom="24dp" />

                <!-- Error banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#FEF2F2"
                    app:strokeColor="#FECACA"
                    app:strokeWidth="1dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="10dp"
                        android:textSize="13sp"
                        android:textColor="#991B1B" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Email field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.SmartAttend.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email Address"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/gray_400">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Password field -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/Widget.SmartAttend.TextInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    android:layout_marginTop="14dp"
                    app:endIconMode="password_toggle"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/gray_400">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:textSize="14sp" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Forgot password -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot password?"
                    android:textSize="13sp"
                    android:textColor="#2563EB"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp"
                    android:layout_gravity="end"
                    android:padding="4dp" />

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="4dp"
                    android:indeterminateTint="@color/brand_primary"
                    android:visibility="gone" />

                <!-- Sign In button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    style="@style/Widget.SmartAttend.Button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="Sign In"
                    android:textSize="15sp" />

                <!-- Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp">

                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E2E8F0" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  Demo Login  " android:textColor="#94A3B8" android:textSize="11sp" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#E2E8F0" />

                </LinearLayout>

                <!-- Demo account chips -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAdmin"
                        style="@style/Widget.SmartAttend.Chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:text="Admin"
                        app:chipBackgroundColor="#F5F3FF"
                        android:textColor="#7C3AED"
                        app:chipStrokeColor="#DDD6FE"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipTeacher"
                        style="@style/Widget.SmartAttend.Chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="4dp"
                        android:text="Teacher"
                        app:chipBackgroundColor="#EFF6FF"
                        android:textColor="#2563EB"
                        app:chipStrokeColor="#BFDBFE"
                        app:chipStrokeWidth="1dp" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStudent"
                        style="@style/Widget.SmartAttend.Chip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:text="Student"
                        app:chipBackgroundColor="#ECFDF5"
                        android:textColor="#059669"
                        app:chipStrokeColor="#A7F3D0"
                        app:chipStrokeWidth="1dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvDemoCredentials"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap a chip to auto-fill credentials"
                    android:textSize="11sp"
                    android:textColor="#CBD5E1"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/tvRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Don't have an account? Register"
                    android:textSize="13sp"
                    android:textColor="#2563EB"
                    android:layout_marginTop="16dp"
                    android:layout_gravity="center"
                    android:padding="8dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Version footer -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SmartAttend v2.0 · Firebase · ML Kit"
            android:textSize="11sp"
            android:textColor="#1E293B"
            android:layout_marginTop="24dp"
            android:layout_gravity="center" />

    </LinearLayout>

</ScrollView>
