<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) for local development -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <!-- Android Emulator loopback -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Your specific network IP for the Vite server -->
        <domain includeSubdomains="true">10.45.79.40</domain>
        <domain includeSubdomains="true">replit.app</domain>
        <domain includeSubdomains="true">replit.dev</domain>
    </domain-config>
</network-security-config>
